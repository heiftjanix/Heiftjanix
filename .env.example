# UPS Tracking API (OAuth2 client-credentials)
# Anlegen unter https://developer.ups.com/ -> App erstellen -> "Tracking" aktivieren.
# Diese Werte als Umgebungs-Secrets hinterlegen (NICHT committen!).
UPS_CLIENT_ID=your-ups-client-id
UPS_CLIENT_SECRET=your-ups-client-secret

# Optional: auf UPS-Testumgebung umstellen (Standard = Produktion)
# UPS_OAUTH_URL=https://wwwcie.ups.com/security/v1/oauth/token
# UPS_TRACK_URL=https://wwwcie.ups.com/api/track/v1/details/

# --- Team-Webapp (webapp/) -------------------------------------------------

# DEMO_MODE=1 startet die Webapp ganz ohne Zugangsdaten (Demo-Login, Demo-Daten,
# Keyword-Fallback statt Claude-Triage). Zum echten Betrieb weglassen/auf 0 setzen.
DEMO_MODE=0

# Azure-App-Registrierung (Azure Portal -> App registrations -> New registration).
# Redirect-URI dort auf {BASE_URL}/auth/callback eintragen; API-Berechtigungen
# (Microsoft Graph, delegiert): User.Read, Mail.Read, Mail.Read.Shared, offline_access.
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_CLIENT_SECRET=your-azure-app-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
BASE_URL=http://localhost:8000

# Anthropic-API-Key für die Mail-Triage (https://console.anthropic.com/).
# Ohne Key: deterministischer Keyword-Fallback statt Claude-Klassifizierung.
ANTHROPIC_API_KEY=your-anthropic-api-key

# ERPNext REST-API (ERPNext -> Nutzer -> API Access -> Generate Keys).
ERPNEXT_URL=https://erp.example.com
ERPNEXT_API_KEY=your-erpnext-api-key
ERPNEXT_API_SECRET=your-erpnext-api-secret

# --- AI-Systems (ai_systems/) ------------------------------------------------

# Bestehende n8n-Instanz: n8n -> Settings -> n8n API -> Create API Key.
# Ohne N8N_URL (oder mit DEMO_MODE=1) läuft AI-Systems im Demo-Modus:
# Demo-Firma, gecannte Claude-Antworten, In-Memory-n8n — keine Zugangsdaten nötig.
N8N_URL=https://n8n.example.com
N8N_API_KEY=your-n8n-api-key

# Claude-Modell für den Agenten-Generator (Default: claude-fable-5).
# AI_SYSTEMS_MODEL=claude-fable-5

# SQLite-Datei für Abteilungen/Agenten/Netzwerkregeln (Default: state/ai_systems.db).
# AI_SYSTEMS_DB=state/ai_systems.db

# GitHub-Konnektor (feiner Personal Access Token mit minimalen Rechten).
GITHUB_TOKEN=your-github-token

# Zufälliger, langer String zum Signieren der Session-Cookies (z. B. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-a-long-random-string
