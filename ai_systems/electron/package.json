{
  "name": "ai-systems-desktop",
  "productName": "AI-Systems",
  "version": "1.1.0",
  "description": "AI-Systems Desktop — Virtuelle Firma für n8n-Agenten mit Claude",
  "main": "main.js",
  "author": "PCB Systems",
  "license": "UNLICENSED",
  "repository": "https://github.com/heiftjanix/Heiftjanix",
  "scripts": {
    "start": "electron .",
    "runtime": "bash build_runtime.sh",
    "dist": "bash build_runtime.sh && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.pcb-systems.ai-systems",
    "productName": "AI-Systems",
    "files": ["main.js", "preload.js", "settings.html", "loader.html"],
    "extraResources": [{"from": "runtime", "to": "runtime"}],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "language": "1031"
    }
  }
}
